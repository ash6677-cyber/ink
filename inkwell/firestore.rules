rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one profile document, keyed by their
    // own uid — nobody can read or write another user's profile or library.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Published read-only copies for beta readers. The unguessable id IS the
    // access control: anyone holding a link may GET, but nobody may LIST the
    // collection — enumeration would turn every private share public.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      // Only a signed-in owner creates a share, and only that same owner can
      // later update or take it down.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /chapters/{chapterId} {
        // Chapter docs are only reachable through a share id someone was
        // given, so listing within one share is as public as getting it.
        allow get, list: if true;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid
            == request.auth.uid;
      }

      // A suggestion box, not a forum: anyone holding the link may drop a
      // note in, but only the book's owner can ever read the box, and
      // nothing in it can be edited after the fact. Strict shape and size
      // validation on the way in — this is the one door anonymous strangers
      // can write through, so it admits exactly one kind of parcel.
      match /comments/{commentId} {
        allow create: if exists(/databases/$(database)/documents/shares/$(shareId))
          && request.resource.data.keys().hasOnly(
            ['chapterIndex', 'quote', 'note', 'name', 'createdAt'])
          && request.resource.data.chapterIndex is int
          && request.resource.data.chapterIndex >= 0
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 2000
          && request.resource.data.quote is string
          && request.resource.data.quote.size() <= 300
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.createdAt is int;
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid
            == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
